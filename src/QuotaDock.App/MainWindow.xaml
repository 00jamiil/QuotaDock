<Window
    x:Class="QuotaDock.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="QuotaDock"
    mc:Ignorable="d">

    <Grid
        x:Name="WidgetRoot"
        AutomationProperties.AutomationId="WidgetRoot"
        AutomationProperties.Name="QuotaDock usage widget"
        Background="{ThemeResource QuotaDockCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="14,10,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="DragRegion" Grid.Column="0" Background="Transparent">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="9">
                    <Border Width="22" Height="22" CornerRadius="7" Background="{ThemeResource QuotaDockAccentBrush}">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource QuotaDockOnAccentBrush}"
                            Glyph="&#xE9D9;"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        Text="QUOTADOCK"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="13"
                        FontWeight="SemiBold"
                        CharacterSpacing="120"
                        Foreground="{ThemeResource QuotaDockTextBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="RefreshButton"
                AutomationProperties.Name="Refresh usage"
                Click="RefreshButton_Click"
                Style="{StaticResource HeaderIconButtonStyle}"
                ToolTipService.ToolTip="Refresh usage">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <Button
                x:Name="PinButton"
                Grid.Column="2"
                AutomationProperties.AutomationId="PinButton"
                AutomationProperties.Name="Pin widget always on top"
                Click="PinButton_Click"
                Style="{StaticResource HeaderIconButtonStyle}"
                ToolTipService.ToolTip="Pin always on top">
                <FontIcon x:Name="PinIcon" FontSize="14" Glyph="&#xE840;" />
            </Button>
            <Button
                x:Name="SettingsButton"
                Grid.Column="3"
                AutomationProperties.AutomationId="SettingsButton"
                AutomationProperties.Name="Open settings"
                Click="SettingsButton_Click"
                Style="{StaticResource HeaderIconButtonStyle}"
                ToolTipService.ToolTip="Connections and settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
            <Button
                x:Name="CloseButton"
                Grid.Column="4"
                AutomationProperties.AutomationId="CloseButton"
                AutomationProperties.Name="Close window"
                Click="CloseButton_Click"
                Style="{StaticResource HeaderIconButtonStyle}"
                ToolTipService.ToolTip="Close">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource QuotaDockDangerColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource QuotaDockDangerColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                </Button.Resources>
                <FontIcon FontSize="14" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!-- Provider tabs -->
        <ScrollViewer
            Grid.Row="1"
            Margin="10,0,10,4"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel
                x:Name="TabStrip"
                AutomationProperties.AutomationId="TabStrip"
                AutomationProperties.Name="Provider tabs"
                Orientation="Horizontal"
                Spacing="4" />
        </ScrollViewer>

        <!-- Status -->
        <Border
            Grid.Row="2"
            Margin="14,2,14,10"
            Padding="13,10"
            Background="{ThemeResource QuotaDockSurfaceBrush}"
            BorderBrush="{ThemeResource QuotaDockBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="HealthDot" Width="7" Height="7" Fill="{ThemeResource QuotaDockMutedBrush}" VerticalAlignment="Center" />
                <TextBlock
                    x:Name="StatusLabel"
                    Grid.Column="1"
                    Margin="9,0,0,0"
                    AutomationProperties.AutomationId="StatusLabel"
                    Text="Connect a provider to begin"
                    FontSize="12"
                    Foreground="{ThemeResource QuotaDockMutedBrush}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- Adaptive metric grid -->
        <ScrollViewer
            Grid.Row="3"
            Margin="8,0"
            Padding="6,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <muxc:ItemsRepeater
                x:Name="MetricRepeater"
                AutomationProperties.AutomationId="MetricList"
                AutomationProperties.Name="Usage metrics">
                <muxc:ItemsRepeater.ItemTemplate>
                <DataTemplate>
                    <Border
                        AutomationProperties.Name="{Binding AutomationName}"
                        Background="{ThemeResource QuotaDockSurfaceBrush}"
                        BorderBrush="{ThemeResource QuotaDockBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <Grid
                                Padding="14,12"
                                RowSpacing="7"
                                Visibility="{Binding ExpandedVisibility}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        Text="{Binding Provider}"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        CharacterSpacing="100"
                                        Foreground="{ThemeResource QuotaDockAccentBrush}" />
                                    <TextBlock
                                        Text="{Binding Label}"
                                        Margin="0,2,0,0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource QuotaDockTextBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,6,0"
                                    Text="{Binding Value}"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource QuotaDockTextBrush}"
                                    VerticalAlignment="Bottom" />
                                <Button
                                    Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Tag="{Binding Key}"
                                    Click="PinToggle_Click"
                                    AutomationProperties.Name="Pin or unpin this metric to Home"
                                    ToolTipService.ToolTip="Pin to Home"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    VerticalAlignment="Top"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center">
                                    <FontIcon FontSize="13" Glyph="&#xE840;" Foreground="{Binding PinBrush}" />
                                </Button>
                                <Button
                                    Grid.Column="3"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Tag="{Binding Key}"
                                    Click="CollapseToggle_Click"
                                    AutomationProperties.Name="{Binding CollapseTooltip}"
                                    ToolTipService.ToolTip="{Binding CollapseTooltip}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    VerticalAlignment="Top"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center">
                                    <FontIcon FontSize="12" Glyph="{Binding CollapseGlyph}" Foreground="{ThemeResource QuotaDockMutedBrush}" />
                                </Button>
                            </Grid>
                            <ProgressBar
                                Grid.Row="1"
                                Height="5"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding ProgressPercent}"
                                Opacity="{Binding ProgressOpacity}"
                                Foreground="{ThemeResource QuotaDockAccentBrush}"
                                Background="{ThemeResource QuotaDockTrackBrush}" />
                            <TextBlock
                                Grid.Row="2"
                                Text="{Binding Detail}"
                                FontSize="11"
                                Foreground="{ThemeResource QuotaDockMutedBrush}" />
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{Binding Account}"
                                    FontSize="10"
                                    Foreground="{ThemeResource QuotaDockMutedBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Reset}"
                                    FontSize="10"
                                    Foreground="{ThemeResource QuotaDockMutedBrush}" />
                            </Grid>
                            <TextBlock
                                Grid.Row="4"
                                Text="{Binding PaceText}"
                                Visibility="{Binding PaceVisibility}"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{Binding PaceBrush}" />
                        </Grid>

                            <!-- Collapsed: a compact quarter-height row. -->
                            <Grid
                                Padding="12,9"
                                ColumnSpacing="10"
                                Visibility="{Binding CollapsedVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding Provider}"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        CharacterSpacing="100"
                                        Foreground="{ThemeResource QuotaDockAccentBrush}" />
                                    <TextBlock
                                        Text="{Binding Label}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource QuotaDockTextBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ProgressBar
                                    Grid.Column="1"
                                    Height="4"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding ProgressPercent}"
                                    Opacity="{Binding ProgressOpacity}"
                                    Foreground="{ThemeResource QuotaDockAccentBrush}"
                                    Background="{ThemeResource QuotaDockTrackBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Value}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource QuotaDockTextBrush}"
                                    VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="3"
                                    Width="26"
                                    Height="26"
                                    Padding="0"
                                    Tag="{Binding Key}"
                                    Click="CollapseToggle_Click"
                                    AutomationProperties.Name="{Binding CollapseTooltip}"
                                    ToolTipService.ToolTip="{Binding CollapseTooltip}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center">
                                    <FontIcon FontSize="11" Glyph="{Binding CollapseGlyph}" Foreground="{ThemeResource QuotaDockMutedBrush}" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
                </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
        </ScrollViewer>

        <Grid Grid.Row="3" x:Name="EmptyState" Margin="28,8,28,20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon x:Name="EmptyIcon" Glyph="&#xE945;" FontSize="24" Foreground="{ThemeResource QuotaDockMutedBrush}" />
                <TextBlock
                    x:Name="EmptyTitle"
                    Text="Your AI limits, one glance away."
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource QuotaDockTextBrush}"
                    TextAlignment="Center" />
                <TextBlock
                    x:Name="EmptySubtitle"
                    Text="Connect Codex, Claude, Grok, or Kimi to start tracking usage."
                    FontSize="12"
                    Foreground="{ThemeResource QuotaDockMutedBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="EmptyActionButton"
                    AutomationProperties.AutomationId="EmptyStateConnectButton"
                    AutomationProperties.Name="Connect a provider"
                    Content="Connect provider"
                    Click="SettingsButton_Click"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0"
                    CornerRadius="4" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Padding="15,4,8,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="FreshnessLabel"
                Text="No local snapshots"
                FontSize="11"
                Foreground="{ThemeResource QuotaDockMutedBrush}"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                Text="LOCAL ONLY"
                FontSize="10"
                FontWeight="SemiBold"
                CharacterSpacing="110"
                Foreground="{ThemeResource QuotaDockAccentBrush}"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="DetailsButton"
                AutomationProperties.Name="Open usage details"
                Content="Details"
                Click="SettingsButton_Click"
                Margin="8,0,0,0"
                Padding="8,2"
                FontSize="11"
                CornerRadius="4" />
        </Grid>
    </Grid>
</Window>
