<Window
    x:Class="QuotaDock.App.DetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="QuotaDock — Usage details">

    <Grid
        x:Name="DetailsRoot"
        AutomationProperties.AutomationId="DetailsRoot"
        AutomationProperties.Name="QuotaDock usage details and connections"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar drag region -->
        <Grid x:Name="TitleBarDragRegion" Height="36" Background="Transparent" />

        <Grid Grid.Row="1" Padding="28,8,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    Text="USAGE DETAILS"
                    FontSize="10"
                    FontWeight="SemiBold"
                    CharacterSpacing="160"
                    Foreground="{ThemeResource QuotaDockAccentBrush}" />
                <TextBlock
                    Text="Accounts, limits &amp; local budgets"
                    Margin="0,5,0,0"
                    FontSize="24"
                    FontWeight="SemiBold"
                    FontFamily="Segoe UI Variable Display"
                    Foreground="{ThemeResource QuotaDockTextBrush}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="AutoDetectButton"
                AutomationProperties.Name="Auto-detect providers and models"
                Click="AutoDetect_Click"
                Padding="14,7"
                Margin="0,0,8,0"
                CornerRadius="4"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="Scan for installed Codex and Claude and connect them automatically">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="13" Glyph="&#xE773;" />
                    <TextBlock Text="Auto-detect" FontSize="13" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="DetailsRefreshButton"
                AutomationProperties.Name="Refresh all providers"
                Content="Refresh all"
                Click="RefreshAll_Click"
                Padding="14,7"
                CornerRadius="4"
                VerticalAlignment="Center" />
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="2"
            Margin="28,0,28,10"
            CornerRadius="{StaticResource QuotaDockCardCorner}"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational" />

        <!-- Per-provider tabs are the primary navigation. Each connected provider
             family gets its own tab; a persistent "Connect" tab hosts setup. -->
        <muxc:TabView
            x:Name="ProviderTabs"
            Grid.Row="3"
            Margin="20,0,20,16"
            AutomationProperties.AutomationId="ProviderTabs"
            IsAddTabButtonVisible="False"
            CanReorderTabs="False"
            CanDragTabs="False"
            TabWidthMode="Equal" />
    </Grid>
</Window>
