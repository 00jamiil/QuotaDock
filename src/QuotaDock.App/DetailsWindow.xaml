<Window
    x:Class="QuotaDock.App.DetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="QuotaDock — Usage details">

    <Grid
        x:Name="DetailsRoot"
        AutomationProperties.AutomationId="DetailsRoot"
        AutomationProperties.Name="QuotaDock usage details and connections"
        Background="{StaticResource QuotaDockCanvasBrush}"
        CornerRadius="{StaticResource QuotaDockWindowCorner}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,20,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    Text="USAGE DETAILS"
                    FontSize="11"
                    FontWeight="SemiBold"
                    CharacterSpacing="140"
                    Foreground="{StaticResource QuotaDockAccentBrush}" />
                <TextBlock
                    Text="Accounts, limits &amp; local budgets"
                    Margin="0,4,0,0"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource QuotaDockTextBrush}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="AutoDetectButton"
                AutomationProperties.Name="Auto-detect providers and models"
                Click="AutoDetect_Click"
                Padding="14,7"
                Margin="0,0,8,0"
                CornerRadius="{StaticResource QuotaDockPillCorner}"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="Scan for installed Codex and Claude and connect them automatically">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="13" Glyph="&#xE773;" />
                    <TextBlock Text="Auto-detect" FontSize="13" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="DetailsRefreshButton"
                AutomationProperties.Name="Refresh all providers"
                Content="Refresh all"
                Click="RefreshAll_Click"
                Padding="14,7"
                CornerRadius="{StaticResource QuotaDockPillCorner}"
                VerticalAlignment="Center" />
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            Margin="24,0,24,8"
            CornerRadius="{StaticResource QuotaDockCardCorner}"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational" />

        <!-- Per-provider tabs are the primary navigation. Each connected provider
             family gets its own tab; a persistent "Connect" tab hosts setup. -->
        <muxc:TabView
            x:Name="ProviderTabs"
            Grid.Row="2"
            Margin="16,0,16,12"
            AutomationProperties.AutomationId="ProviderTabs"
            IsAddTabButtonVisible="False"
            CanReorderTabs="False"
            CanDragTabs="False"
            TabWidthMode="Equal" />
    </Grid>
</Window>
