<Application
    x:Class="QuotaDock.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="QuotaDockCanvasColor">#10131A</Color>
            <Color x:Key="QuotaDockSurfaceColor">#191E28</Color>
            <Color x:Key="QuotaDockSurfaceRaisedColor">#212836</Color>
            <Color x:Key="QuotaDockTextColor">#F3F6FB</Color>
            <Color x:Key="QuotaDockMutedColor">#9AA6B8</Color>
            <Color x:Key="QuotaDockAccentColor">#62D6B5</Color>
            <Color x:Key="QuotaDockWarningColor">#F2BA55</Color>
            <Color x:Key="QuotaDockDangerColor">#FA7A86</Color>

            <SolidColorBrush x:Key="QuotaDockCanvasBrush" Color="{StaticResource QuotaDockCanvasColor}" />
            <SolidColorBrush x:Key="QuotaDockSurfaceBrush" Color="{StaticResource QuotaDockSurfaceColor}" />
            <SolidColorBrush x:Key="QuotaDockSurfaceRaisedBrush" Color="{StaticResource QuotaDockSurfaceRaisedColor}" />
            <SolidColorBrush x:Key="QuotaDockTextBrush" Color="{StaticResource QuotaDockTextColor}" />
            <SolidColorBrush x:Key="QuotaDockMutedBrush" Color="{StaticResource QuotaDockMutedColor}" />
            <SolidColorBrush x:Key="QuotaDockAccentBrush" Color="{StaticResource QuotaDockAccentColor}" />
            <SolidColorBrush x:Key="QuotaDockWarningBrush" Color="{StaticResource QuotaDockWarningColor}" />
            <SolidColorBrush x:Key="QuotaDockDangerBrush" Color="{StaticResource QuotaDockDangerColor}" />

            <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource QuotaDockMutedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- Shared rounded-corner radii so the widget and flyout read as one
                 soft, modern surface. -->
            <CornerRadius x:Key="QuotaDockCardCorner">16</CornerRadius>
            <CornerRadius x:Key="QuotaDockWindowCorner">18</CornerRadius>
            <CornerRadius x:Key="QuotaDockPillCorner">999</CornerRadius>

            <Style x:Key="QuotaDockCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource QuotaDockSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="#2B3341" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource QuotaDockCardCorner}" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
